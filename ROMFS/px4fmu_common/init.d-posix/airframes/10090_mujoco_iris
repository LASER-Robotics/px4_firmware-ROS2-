#!/bin/sh
#
# @name Cuadrotor acp en MuJoCo (puente HIL px4_mujoco)
#
# @type Quadrotor Wide
#

. ${R}etc/init.d/rc.mc_defaults


param set-default CA_AIRFRAME 0

param set-default CA_ROTOR_COUNT 4
param set-default CA_ROTOR0_PX 0.1515
param set-default CA_ROTOR0_PY 0.245
param set-default CA_ROTOR0_KM 0.05
param set-default CA_ROTOR1_PX -0.1515
param set-default CA_ROTOR1_PY -0.1875
param set-default CA_ROTOR1_KM 0.05
param set-default CA_ROTOR2_PX 0.1515
param set-default CA_ROTOR2_PY -0.245
param set-default CA_ROTOR2_KM -0.05
param set-default CA_ROTOR3_PX -0.1515
param set-default CA_ROTOR3_PY 0.1875
param set-default CA_ROTOR3_KM -0.05

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104

# --- planta MuJoCo del acp (1.05 kg, J ~ 0.0027/0.0027/0.0053, motores tau 25 ms + 18 ms) ---
param set-default MC_ROLLRATE_P 0.045
param set-default MC_ROLLRATE_I 0.06
param set-default MC_ROLLRATE_D 0.0008
param set-default MC_PITCHRATE_P 0.045
param set-default MC_PITCHRATE_I 0.06
param set-default MC_PITCHRATE_D 0.0008
param set-default MC_YAWRATE_P 0.10
param set-default MC_YAWRATE_I 0.05
param set-default MPC_THR_HOVER 0.78
param set-default MPC_USE_HTE 1
param set-default UXRCE_DDS_DOM_ID 11

# px4_mujoco 28/10: bateria como la del FC real (6S, avisos por voltaje). Con la planta mandando ESC_STATUS, el
# battery_simulator publica el voltaje y la corriente del gemelo (que se descarga solo, bat_q_ah).
param set-default BAT1_N_CELLS 6
param set-default BAT1_V_CHARGED 4.2
param set-default BAT1_V_EMPTY 3.38
param set-default BAT1_CAPACITY -1
